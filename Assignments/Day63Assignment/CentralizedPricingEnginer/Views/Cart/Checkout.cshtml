@model CentralizedPricingEngine.Models.ViewModel.Cart

@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout succesfull</h1>

<div>
    <h4>Cart</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TotalPrice)
        </dt>
